{
  "name": "playwright-llm-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Test harness for non-deterministic LLM outputs: property assertions, pass-rate thresholds, and adversarial input tests.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:properties": "vitest run tests/properties.spec.ts",
    "test:multi-run": "vitest run tests/multi-run.spec.ts",
    "test:adversarial": "vitest run tests/adversarial.spec.ts",
    "test:db": "vitest run tests/db-verification.spec.ts",
    "test:allure": "vitest run --reporter=allure-vitest/reporter",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:clean": "rm -rf allure-results allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "dependencies": {
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "allure-js-commons": "^3.12.1",
    "allure-vitest": "^3.12.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
