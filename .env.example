# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit real keys.

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# Which provider to use. Supported: openai | ollama
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# -----------------------------------------------------------------------------
# Harness behaviour
# -----------------------------------------------------------------------------
# How many times to run each prompt in a multi-run test.
LLM_TEST_RUNS=5

# Default pass-rate threshold for multi-run tests (0..1).
LLM_TEST_PASS_RATE=0.8

# Per-request timeout in milliseconds.
LLM_TEST_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Database (only needed for db-verification tests, added in Week 1 Day 5)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@localhost:5432/llm_tests